{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "drivkraft/valkyrie",
    "description": "Role-based authorization for Laravel \u2014 roles, permissions and abilities with scoped grants for teams and multi-tenancy, ownership rules, forbids that always win, and Gate integration.",
    "keywords": [
        "laravel",
        "laravel-package",
        "valkyrie",
        "drivkraft",
        "authorization",
        "access-control",
        "rbac",
        "acl",
        "roles",
        "permissions",
        "abilities",
        "gate",
        "eloquent",
        "multi-tenancy",
        "ownership"
    ],
    "homepage": "https://github.com/drivkraft/valkyrie",
    "license": "MIT",
    "authors": [
        {
            "name": "Kim Eric Helle",
            "email": "kim.helle@signl.no",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Drivkraft\\Valkyrie\\": "src/",
            "Drivkraft\\Valkyrie\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drivkraft\\Valkyrie\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Drivkraft\\Valkyrie\\ValkyrieServiceProvider"
            ],
            "aliases": {
                "Valkyrie": "Drivkraft\\Valkyrie\\Facades\\Valkyrie"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
